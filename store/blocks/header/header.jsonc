{
  "header": {
    "blocks": [
      "header-layout.desktop",
      "header-layout.mobile"
    ]
  },
  "header.full": {
    "blocks": [
      "header-layout.desktop",
      "header-layout.mobile"
    ]
  },
  "header-layout.desktop": {
    "children": [
      "sticky-layout#desktop"
    ]
  },
  "sticky-layout#desktop": {
    "props": {
      "blockClass": "sticky-header"
    },
    "children": [
      "notification.bar#announcement",
      "flex-layout.row#desktop"
    ]
  },
  "notification.bar#announcement": {
    "props": {
      "content": "⚡Frete grátis acima de R$ 199 · Entrega em todo o Brasil⚡"
    }
  },
  "flex-layout.row#desktop": {
    "props": {
      "horizontalAlign": "center",
      "verticalAlign": "center",
      "preventHorizontalStretch": true,
      "preventVerticalStretch": true,
      "fullWidth": true,
      "blockClass": "main-header"
    },
    "children": [
      "flex-layout.col#logo-desktop",
      "vtex.menu@2.x:menu#navigation",
      "flex-layout.col#spacer",
      "disclosure-layout#search",
      "login",
      "minicart.v2"
    ]
  },
  "flex-layout.col#spacer": {
    "props": {
      "width": "grow"
    }
  },
  "disclosure-layout#search": {
    "children": [
      "disclosure-trigger#search",
      "disclosure-content#search"
    ],
    "props": {
      "blockClass": "disclosure-search"
    }
  },
  "disclosure-trigger#search": {
    "children": [
      "image#icon-search"
    ],
    "props": {
      "blockClass": "disclosure-search"
    }
  },
  "disclosure-content#search": {
    "children": [
      "search-bar"
    ],
    "props": {
      "blockClass": "disclosure-search"
    }
  },
  "image#icon-search": {
    "props": {
      "src": "https://partnersigrowdev.vtexassets.com/assets/vtex.file-manager-graphql/images/0a55b4d4-e730-4ef4-bed2-7f65175b5cd8___e679c79a6e253784e307e82b51346162.svg",
      "blockClass": "disclosure-search"
    }
  },
  "flex-layout.col#logo-desktop": {
    "props": {
      "verticalAlign": "middle"
    },
    "children": [
      "logo"
    ]
  },
  "logo": {
    "props": {
      "title": "Logo",
      "href": "/",
      "url": "https://partnersigrowdev.vtexassets.com/assets/vtex.file-manager-graphql/images/4f7baa10-f8f0-438c-bbd2-d6baa2e21b7c___92fbf8935806ece8de1b82703478c3fd.svg",
      "width": "180",
      "height": "70"
    }
  },
  "header-layout.mobile": {
    "children": [
      "sticky-layout#mobile"
    ]
  },
  "sticky-layout#mobile": {
    "children": [
      "flex-layout.row#mobile"
    ]
  },
  "flex-layout.row#mobile": {
    "children": [
      "drawer",
      "logo",
      "flex-layout.col#spacer",
      "login",
      "minicart.v2"
    ],
    "props": {
      "blockClass": "main-header-mobile",
      "preventHorizontalStretch": true,
      "preserveLayoutOnMobile": true,
      "fullWidth": true
    }
  },
  "drawer": {
    "children": []
  }
}