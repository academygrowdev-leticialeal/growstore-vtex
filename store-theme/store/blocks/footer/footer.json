{
  "footer": {
    "blocks": ["footer-layout.desktop", "footer-layout.mobile"]
  },
  "footer-layout.desktop": {
    "children": [
      "flex-layout.row#footer-1-desktop",
      "flex-layout.row#footer-3-desktop"
    ]
  },
  "flex-layout.row#footer-1-desktop": {
    "children": [
      "flex-layout.col#footer-logo",
      "vtex.menu@2.x:menu#department",
      "vtex.menu@2.x:menu#minha-conta",
      "vtex.menu@2.x:menu#footer-institutional",
      "vtex.menu@2.x:menu#contact"

    ],
    "props": {
      "blockClass": "menu-row",
      "paddingTop": 8,
      "paddingBottom": 3,
      "colGap": 4
    }
  },

  "flex-layout.col#footer-logo":{
    "children": ["image#footer-logo", "rich-text#footer-description", "social-networks", "accepted-payment-methods"],
    "props": {
      "blockClass": "footer-logo"
    }
  },

  "image#footer-logo":{
    "props": {
      "src": "https://partnersigrowdev.vtexassets.com/assets/vtex.file-manager-graphql/images/4f7baa10-f8f0-438c-bbd2-d6baa2e21b7c___92fbf8935806ece8de1b82703478c3fd.svg",
      "blockClass": "footer-logo"
    }
  },

  "rich-text#footer-description":{
    "props": {
      "text": "A loja oficial de produtos customizados e exclusivos das marcas Growdev e Growlabs. Produtos para quem vive e respira tecnologia.",
      "blockClass": "footer-description"
    }
  },

  "social-networks": {
    "props": {
      "blockclass": "footer-social",
      "socialNetworks": [
        {
          "name": "Facebook",
          "url": "https://www.facebook.com/vtexonline/"
        },
        {
          "name": "Instagram",
          "url": "https://www.instagram.com/vtextruecloud/"
        },
        {
          "name": "Twitter",
          "url": "https://twitter.com/vtexonline"
        },
        {
          "name": "Youtube",
          "url": "https://www.youtube.com/user/VTEXTV"
        }
      ]
    }
  },

  "accepted-payment-methods": {
    "props": {
      "paymentMethods": ["MasterCard", "Visa", "Diners Club"],
      "blockClass": "footer-payments"
    }
  },

 "flex-layout.row#footer-3-desktop": {
    "children": [
      "rich-text#footer",
      "rich-text#footer-payments" 
    ],
    "props": {
      "blockClass": "credits",
      "horizontalAlign": "between",
      "preventHorizontalStretch": true,
      "paddingTop": 4,
      "paddingBottom": 4
    }
  },
  "rich-text#footer-payments": {
    "props": {
      "text": "Pagamentos: &nbsp;&nbsp; Visa &nbsp;&nbsp; Master &nbsp;&nbsp; Pix &nbsp;&nbsp; Boleto &nbsp;&nbsp; Amex",
      "blockClass": "footer-text-payments"
    }
  },

  "rich-text#footer": {
    "props": {
      "text": "© 2026 Grow Store — Growdev & Growlabs. Todos os direitos reservados.",
      "blockClass": "footer"
    }
  },

  "footer-layout.mobile": {
    "children": [
      "flex-layout.row#footer-logo-mobile",
      "flex-layout.row#1-footer-mobile",
      "flex-layout.row#2-footer-mobile"
    ]
  },
  "flex-layout.row#footer-logo-mobile": {
    "children": ["flex-layout.col#footer-logo-mobile"],
    "props": {
      "paddingTop": 6,
      "paddingBottom": 4,
      "blockClass": "footer-logo-row-mobile"
    }
  },

  "flex-layout.col#footer-logo-mobile": {
    "children": [
      "image#footer-logo",
      "rich-text#footer-description"
    ],
    "props": {
      "horizontalAlign": "center",
      "verticalAlign": "middle",
      "rowGap": 4,
      "blockClass": "footer-logo-col-mobile"
    }
  },

  "flex-layout.row#2-footer-mobile": {
    "children": ["flex-layout.col#footer-1-mobile"],
    "props": {
      "blockClass": "payment-methods",
      "paddingTop": 4,
      "paddingBottom": 4
    }
  },
  "flex-layout.col#footer-1-mobile": {
    "children": [
      "social-networks",
      "accepted-payment-methods",
      "rich-text#footer"
    ],
    "props": {
      "horizontalAlign": "center",
      "blockClass": "payment-methods",
      "paddingTop": 4,
      "paddingBottom": 4,
      "rowGap": 5
    }
  },
  "flex-layout.row#1-footer-mobile": {
    "props": {
      "paddingTop": 4,
      "paddingBottom": 4
    },
    "children": ["vtex.menu@2.x:menu#footer-mobile"]
  },
  "rich-text#footer-mobile": {
    "props": {
      "text": "© 2026 Grow Store — Growdev & Growlabs. Todos os direitos reservados.",
      "blockClass": "footer"
    }
  }
}
