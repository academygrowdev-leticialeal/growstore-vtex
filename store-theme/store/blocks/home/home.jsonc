{
  "store.home": {
    "blocks": [
      "home-banner",
      /* You can make references to blocks defined in other files.
       * For example, `flex-layout.row#deals` is defined in the `deals.json` file. */
      "__fold__",
      "flex-layout.row#growstore-categories",
      "flex-layout.row#shelf",
      "flex-layout.row#banner-highlight",
      "flex-layout.row#brands-highlight",
      "benefits-bar"
    ]
  },

  /* Início - Shelf Item */
  "flex-layout.row#growstore-categories": {
    "children": ["flex-layout.col#home-categories"]
  },
  "flex-layout.col#home-categories": {
    "children": [
      "rich-text#home-categories-text",
      "rich-text#home-categories-title",
      "shelf-item-growstore"
    ],
    "props": {
      "blockClass": "homeCategories"
    }
  },
  "rich-text#home-categories-text": {
    "props": {
      "text": "Explore",
      "blockClass": "homeCategoriesText"
    }
  },
  "rich-text#home-categories-title": {
    "props": {
      "text": "## Categorias",
      "blockClass": "homeCategoriesTitle"
    }
  },
  "shelf-item-growstore": {
    "props": {
      "categories": [
        {
          "icon": "👕",
          "text": "Camisetas",
          "link": "/camisetas",
          "qtde": ""
        },
        {
          "icon": "☕",
          "text": "Canecas",
          "link": "/canecas",
          "qtde": ""
        },
        {
          "icon": "🎒",
          "text": "Mochilas",
          "link": "/mochilas",
          "qtde": ""
        },
        {
          "icon": "🧴",
          "text": "Garrafas",
          "link": "/garrafas-termicas",
          "qtde": ""
        },
        {
          "icon": "🥤",
          "text": "Copos",
          "link": "/copos-termicos",
          "qtde": ""
        },
        {
          "text": "Blocos de Nota",
          "icon": "📓",
          "link": "/blocos-de-nota",
          "qtde": ""
        },
        {
          "icon": "🖊️",
          "text": "Canetas",
          "link": "/canetas",
          "qtde": ""
        },
        {
          "icon": "🏷️",
          "text": "Adesivos",
          "link": "/adesivos",
          "qtde": ""
        },
        {
          "icon": "🖱️",
          "text": "Mousepads",
          "link": "/mousepads",
          "qtde": ""
        }
      ]
    }
  },
  /*Fim - Shelf Item */

  /* Início - Vitine */
  "rich-text#shelf-subtitle": {
    "props": {
      "text": "SELECIONADOS",
      "blockClass": "shelf-subtitle"
    }
  },
  "rich-text#shelf-title": {
    "props": {
      "text": "## Produtos em Destaque",
      "blockClass": "shelf-title"
    }
  },
  /* Fim - Vitrine */

  /* Início - Banner Highlight */
  "flex-layout.row#banner-highlight": {
    "children": ["grow-store-home-banner-highlight"],
    "props": {
      "fullWidth": true,
      "blockClass": "background-default"
    }
  },
  "grow-store-home-banner-highlight": {
    "props": {
      "image": "assets/images/banner_promo.webp",
      "title": "Mochila Tech Pro",
      "description": "A mochila definitiva para devs. Compartimento para notebook, USB integrada e design premium.",
      "buttonText": "Comprar Agora",
      "buttonLink": "/mochilas"
    }
  },
  /* Início - Brands Highlight */
  "flex-layout.row#brands-highlight": {
    "children": ["brands-highlight-growstore"],
    "props": {
      "fullWidth": true,
      "blockClass": "background-brands"
    }
  },
  "brands-highlight-growstore": {
    "props": {
      "brands": [
        {
          "name": "Growdev",
          "description": "Conectando talentos e tecnologia para transformar negócios. Formação tech, outsourcing e inovação.",
          "link": "/growdev"
        },
        {
          "name": "Growlabs",
          "description": "Impulsionando negócios através de pessoas e tecnologia. Soluções digitais sob medida.",
          "link": "/growlabs"
        }
      ]
    }
  },
  /* Fim - Brands Highlight */

  /* Início Benefits Bar */
  "benefits-bar": {
    "props": {
      "benefits": [
        {
          "iconUrl": "https://partnersigrowdev.vtexassets.com/assets/vtex.file-manager-graphql/images/dcafd06d-95a9-401c-83e9-efc01d32535c___4f427a592270ddf8297dc2c5ed6fec15.svg",
          "title": "Frete Grátis",
          "subtitle": "Acima de R$ 199"
        },
        {
          "iconUrl": "https://partnersigrowdev.vtexassets.com/assets/vtex.file-manager-graphql/images/658c17dd-2b1e-4501-9459-0560cdd5f8f5___98a60d39f338bb82abebf8cbe2b034ae.svg",
          "title": "Compra Segura",
          "subtitle": "Pagamento protegido"
        },
        {
          "iconUrl": "https://partnersigrowdev.vtexassets.com/assets/vtex.file-manager-graphql/images/b5c4d64a-4ad0-42b0-a16c-837c49009b71___17afa4789d96c1c05258391c11cff190.svg",
          "title": "Troca Fácil",
          "subtitle": "Até 30 dias"
        },
        {
          "iconUrl": "https://partnersigrowdev.vtexassets.com/assets/vtex.file-manager-graphql/images/f91a69a9-fb29-4db8-81cf-36398b324759___03f4824c3241c726dbd87770a19f66e7.svg",
          "title": "Suporte",
          "subtitle": "Segund à Sexta"
        }
      ]
    }
  },
  /* Fim Benefits Bar */
  "flex-layout.row#shelf": {
    "children": ["flex-layout.col#shelf-container"],
    "props": {
      "blockClass": "background-default"
    }
  },
  "flex-layout.col#shelf-container": {
    "children": [
      "rich-text#shelf-subtitle",
      "rich-text#shelf-title",
      "list-context.product-list#demo1"
    ],
    "props": {
      "blockClass": "shelf-container"
    }
  },

  "list-context.product-list#demo1": {
    "blocks": ["product-summary.shelf"],
    "children": ["slider-layout#demo-products"],
    "props": {
      "orderBy": "OrderByTopSaleDESC"
    }
  },

  "slider-layout#demo-products": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 1
      },
      "infinite": true,
      "fullWidth": false,
      "blockClass": "shelf"
    }
  }
}
