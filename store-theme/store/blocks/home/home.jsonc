{
  "store.home": {
    "blocks": [
      "slider-layout#home-banner",
      /* You can make references to blocks defined in other files.
       * For example, `flex-layout.row#deals` is defined in the `deals.json` file. */
      "__fold__",
      "flex-layout.row#growstore-categories",
      "flex-layout.row#shelf",
      "flex-layout.row#banner-highlight",
      "flex-layout.row#brands-highlight"
    ]
  },
  "slider-layout#home-banner": {
    "props": {
      "itemsPerPage": {
        "desktop": 1,
        "tablet": 1,
        "phone": 1
      },
      "infinite": true,
      "showNavigationArrows": "always",
      "showPaginationDots": "always",
      "autoplay": {
        "timeout": 5000,
        "stopOnHover": true
      },
      "blockClass": "homeBannerSlider"
    },
    "children": ["home-banner#slider1", "home-banner#slider2"]
  },
  "home-banner#slider1": {
    "props": {
      "tag": "— LOJA OFICIAL",
      "title": "Gear para",
      "highlightedWord": "Growdevers",
      "subtitle": "Produtos exclusivos e customizados das marcas Growdev e Growlabs. Para quem vive e respira tecnologia.",
      "btnPrimaryLabel": "Ver Todos os Produtos →",
      "btnPrimaryHref": "/growlabs",
      "btnSecondaryLabel": "Camisetas",
      "btnSecondaryHref": "/camisetas",
      "stat1Number": "9+",
      "stat1Label": "Categorias",
      "stat2Number": "50+",
      "stat2Label": "Produtos",
      "stat3Number": "1.5k+",
      "stat3Label": "Growdevers",
      "imageUrl": "https://partnersigrowdev.vtexassets.com/assets/vtex.file-manager-graphql/images/f784535a-9fb8-4771-9ffe-2599e387e316___f5b739dd734a4deed7a06909d096324f.jpeg",
      "imageAlt": "Produtos Grow"
    }
  },
  "home-banner#slider2": {
    "props": {
      "tag": "— NOVIDADES",
      "title": "Style para",
      "highlightedWord": "Growdevers",
      "subtitle": "Confira a nova coleção de mochilas e acessórios exclusivos para o seu setup.",
      "btnPrimaryLabel": "Ver Novidades →",
      "btnPrimaryHref": "/novidades",
      "btnSecondaryLabel": "Acessórios",
      "btnSecondaryHref": "/acessorios",
      "stat1Number": "9+",
      "stat1Label": "Categorias",
      "stat2Number": "50+",
      "stat2Label": "Mochilas",
      "stat3Number": "1.5k+",
      "stat3Label": "Growdevers",
      "imageUrl": "https://partnersigrowdev.vtexassets.com/assets/vtex.file-manager-graphql/images/d1b3d576-cd8a-4e7c-9af0-47648523cdcc___0c845cbe192accb266e3e56a91778f0e.jpg",
      "imageAlt": "Moletons Grow"
    }
  },

  /* Início - Shelf Item */
  "flex-layout.row#growstore-categories": {
    "children": ["flex-layout.col#home-categories"]
  },
  "flex-layout.col#home-categories": {
    "children": [
      "rich-text#home-categories-text",
      "rich-text#home-categories-title",
      "shelf-item-growstore"
    ],
    "props": {
      "blockClass": "homeCategories"
    }
  },
  "rich-text#home-categories-text": {
    "props": {
      "text": "Explore",
      "blockClass": "homeCategoriesText"
    }
  },
  "rich-text#home-categories-title": {
    "props": {
      "text": "## Categorias",
      "blockClass": "homeCategoriesTitle"
    }
  },
  "shelf-item-growstore": {
    "props": {
      "categories": [
        {
          "icon": "👕",
          "text": "Camisetas",
          "link": "/camisetas",
          "qtde": ""
        },
        {
          "icon": "☕",
          "text": "Canecas",
          "link": "/canecas",
          "qtde": ""
        },
        {
          "icon": "🎒",
          "text": "Mochilas",
          "link": "/mochilas",
          "qtde": ""
        },
        {
          "icon": "🧴",
          "text": "Garrafas",
          "link": "/garrafas-termicas",
          "qtde": ""
        },
        {
          "icon": "🥤",
          "text": "Copos",
          "link": "/copos-termicos",
          "qtde": ""
        },
        {
          "text": "Blocos de Nota",
          "icon": "📓",
          "link": "/blocos-de-nota",
          "qtde": ""
        },
        {
          "icon": "🖊️",
          "text": "Canetas",
          "link": "/canetas",
          "qtde": ""
        },
        {
          "icon": "🏷️",
          "text": "Adesivos",
          "link": "/adesivos",
          "qtde": ""
        },
        {
          "icon": "🖱️",
          "text": "Mousepads",
          "link": "/mousepads",
          "qtde": ""
        }
      ]
    }
  },
  /*Fim - Shelf Item */

  /* Início - Vitine */
  "rich-text#shelf-subtitle": {
    "props": {
      "text": "SELECIONADOS",
      "blockClass": "shelf-subtitle"
    }
  },
  "rich-text#shelf-title": {
    "props": {
      "text": "## Produtos em Destaque",
      "blockClass": "shelf-title"
    }
  },
  /* Fim - Vitrine */

  /* Início - Banner Highlight */
  "flex-layout.row#banner-highlight": {
    "children": ["grow-store-home-banner-highlight"],
    "props": {
      "fullWidth": true,
      "blockClass": "background-default"
    }
  },
  "grow-store-home-banner-highlight": {
    "props": {
      "image": "assets/images/banner_promo.webp",
      "title": "Mochila Tech Pro",
      "description": "A mochila definitiva para devs. Compartimento para notebook, USB integrada e design premium.",
      "buttonText": "Comprar Agora",
      "buttonLink": "/mochilas"
    }
  },
  /* Início - Brands Highlight */
  "flex-layout.row#brands-highlight": {
    "children": ["brands-highlight-growstore"],
    "props": {
      "fullWidth": true,
      "blockClass": "background-brands"
    }
  },
  "brands-highlight-growstore": {
    "props": {
      "brands": [
        {
          "name": "Growdev",
          "description": "Conectando talentos e tecnologia para transformar negócios. Formação tech, outsourcing e inovação.",
          "link": "/growdev"
        },
        {
          "name": "Growlabs",
          "description": "Impulsionando negócios através de pessoas e tecnologia. Soluções digitais sob medida.",
          "link": "/growlabs"
        }
      ]
    }
  },
  /* Fim - Brands Highlight */
  "flex-layout.row#shelf": {
    "children": ["flex-layout.col#shelf-container"],
    "props": {
      "blockClass": "background-default"
    }
  },
  "flex-layout.col#shelf-container": {
    "children": [
      "rich-text#shelf-subtitle",
      "rich-text#shelf-title",
      "list-context.product-list#demo1"
    ],
    "props": {
      "blockClass": "shelf-container"
    }
  },

  "list-context.product-list#demo1": {
    "blocks": ["product-summary.shelf"],
    "children": ["slider-layout#demo-products"],
    "props": {
      "orderBy": "OrderByTopSaleDESC"
    }
  },

  "slider-layout#demo-products": {
    "props": {
      "itemsPerPage": {
        "desktop": 4,
        "tablet": 3,
        "phone": 1
      },
      "infinite": true,
      "fullWidth": false,
      "blockClass": "shelf"
    }
  }
}
