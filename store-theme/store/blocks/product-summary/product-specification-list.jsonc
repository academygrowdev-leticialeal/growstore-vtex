{
  "product-specification-group#summary": {
    "children": [
      "product-specification#summary"
    ]
  },
  "product-specification#summary": {
    "children": [
      "flex-layout.row#summarySpecificationValues"
    ]
  },
  "flex-layout.row#summarySpecificationValues": {
    "props": {
      "preventHorizontalStretch": true,
      "colGap": 3
    },
    "children": [
      "rich-text#summarySpecificationBullet",
      "product-specification-values#summaryText"
    ]
  },
  "product-specification-values#summaryText": {
    "children": [
      "product-specification-text#summaryTextValue"
    ]
  },
  "product-specification-text#summaryTextValue": {
    "props": {
      "message": "{specificationValue}",
      "blockClass": "summarySpecificationText"
    }
  },
  "rich-text#summarySpecificationBullet": {
    "props": {
      "text": "•",
      "blockClass": "summarySpecificationBullet"
    }
  }
}
